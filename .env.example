# Supabase configuration for the Aba Power Admin Dashboard.
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> API.
#
#   VITE_SUPABASE_URL            the "Project URL"
#   VITE_SUPABASE_ANON_KEY       the client-side key ("Publishable key" or
#                                legacy "anon public")
#   VITE_SUPABASE_MEDIA_BUCKET   optional storage bucket for admin uploads
#                                (defaults to "cms-media")
#   VITE_SUPABASE_TID_BUCKET     optional storage bucket holding customer meter
#                                records for the TID token page
#                                (defaults to "tid-meter-records")
#
# The client key is safe to expose in the browser because it is constrained by
# Row Level Security. NEVER put the `service_role` key in a VITE_ variable, as
# Vite inlines it into the client bundle.

VITE_SUPABASE_URL=https://zfhrlhgvzwjgteuclnyt.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_4t23ksDD4aMEmtrTVb0khw_c1QJ7z0l
VITE_SUPABASE_MEDIA_BUCKET=cms-media
VITE_SUPABASE_TID_BUCKET=tid-meter-records
